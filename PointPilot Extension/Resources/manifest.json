{
    "manifest_version": 3,
    "default_locale": "en",

    "name": "__MSG_extension_name__",
    "description": "__MSG_extension_description__",
    "version": "1.0",

    "icons": {
        "16": "../../PointPilot.png",
        "32": "../../PointPilot.png",
        "48": "../../PointPilot.png",
        "128": "../../PointPilot.png",
        "256": "../../PointPilot.png",
        "512": "../../PointPilot.png"
    },

    "background": {
        "scripts": [ "background.js" ],
        "type": "module"
    },

    "content_scripts": [{
        "js": [ "content.js" ],
        "matches": [ "*://example.com/*" ]
    }],

    "action": {
        "default_popup": "popup.html",
        "default_icon": "../../PointPilot.png"
    },

    "permissions": [ ]
}
